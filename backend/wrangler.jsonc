{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nature-relay-community-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "FREE_ONLY": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nature-relay-community-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
